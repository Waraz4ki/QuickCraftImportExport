<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <KsaDir Condition="'$(KsaDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\refs\game</KsaDir>


    <OutputPath>/home/zaziki/Documents/My Games/Kitten Space Agency/mods/QuickCraftImportExport/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
    <PackageReference Include="StarMap.API" Version="0.3.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="TextCopy" Version="6.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="KSA">
      <HintPath>$(KsaDir)/KSA.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Numerics">
      <HintPath>$(KsaDir)/Brutal.Core.Numerics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Logging">
      <HintPath>$(KsaDir)/Brutal.Core.Logging.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.GlfwApi">
      <HintPath>$(KsaDir)/Brutal.Glfw.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Planet.Render.Core">
      <HintPath>$(KsaDir)/Planet.Render.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="CommunityToolkit.HighPerformance">
      <HintPath>$(KsaDir)/CommunityToolkit.HighPerformance.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui">
      <HintPath>$(KsaDir)/Brutal.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.ImGui.Abstractions">
      <HintPath>$(KsaDir)/Brutal.ImGui.Abstractions.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Core.Strings">
      <HintPath>$(KsaDir)/Brutal.Core.Strings.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Brutal.Localization">
      <HintPath>$(KsaDir)/Brutal.Localization.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepuUtilities">
      <HintPath>$(KsaDir)/BepuUtilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="mod.toml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="ValidateKsaDir" BeforeTargets="ResolveReferences">
    <Error
      Condition="!Exists('$(KsaDir)/KSA.dll')"
      Text="KsaDir is '$(KsaDir)', but KSA.dll was not found there. Set KsaDir with /p:KsaDir=/absolute/path/to/game/folder or update the default in the project file." />
  </Target>

</Project>
